# Browser Use API Environment Configuration
# Copy this file to .env and fill in your actual values

# Browser Configuration
NUM_BROWSER_WORKERS=2
CLONED_PROFILES_BASE_DIR=~/.config/browseruse/profiles
START_CDP_PORT=9222
HEADLESS_MODE=true

# Chrome Configuration
BROWSER_PROFILES_DIR=~/.config/browseruse/profiles
CHROME_EXECUTABLE=/usr/bin/google-chrome
CHROME_START_PORT=9222
CHROME_NUM_PROFILES=2
CHROME_HEADLESS=true

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# API Configuration
API_BASE_URL=http://localhost:8000

# Test Configuration
SUCCESS_TEST_CASES_PATH=test/test_data/success_test_cases.json
FAILURE_TEST_CASES_PATH=test/test_data/failure_test_cases.json
RAW_SUCCESS_TEST_RESULTS_PATH=test/results/raw_success_test_results.json
RAW_FAILURE_TEST_RESULTS_PATH=test/results/raw_failure_test_results.json
EVALUATED_SUCCESS_TEST_RESULTS_PATH=test/results/evaluated_success_test_results.json
EVALUATED_FAILURE_TEST_RESULTS_PATH=test/results/evaluated_failure_test_results.json

# Display Configuration (for headless mode)
DISPLAY=:99
